# Copy to .env.local for local dev (point at the staging Supabase project, never production).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret used to sign/verify the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value per environment (local/staging vs. production).
SESSION_SECRET=generate-your-own-64-char-hex-value

# The private code new players must enter to self-signup. Set this to
# whatever you actually tell your competition's players.
COMPETITION_CODE=your-competition-code

# football-data.org API token (free tier, 10 calls/minute -- see CLAUDE.md's
# Stack section). Used by scripts/seed-fixtures.mjs and the standings sync
# route (src/app/api/sync/standings).
FOOTBALL_DATA_API_KEY=your-football-data-org-token

# Shared secret the standings sync route (src/app/api/sync/standings) checks
# on the x-sync-secret header, since it's called server-to-server rather than
# by a logged-in player. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TRIGGER_SECRET=generate-your-own-64-char-hex-value
